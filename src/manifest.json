{
  "manifest_version": 2,
  "name": "TraceLens",
  "version": "0.1.1",
  "description": "Analyze the current tab's trackers and privacy signals locally, with no browsing history.",
  "permissions": [
    "webRequest",
    "cookies",
    "downloads",
    "webNavigation",
    "*://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "TraceLens privacy report",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_security_policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "tracelens@adulph3",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
